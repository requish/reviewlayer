Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_METHOD} ^(?:TRACE|TRACK)$ [NC]
  RewriteRule ^ - [F,L]
  RewriteRule ^(?:tests|tools)(?:/|$) - [F,L,NC]
  RewriteRule ^api/pins/([0-9a-f-]+)/messages/?$ api/index.php?action=add-message&id=$1 [QSA,L,NC]
  RewriteRule ^api/pins/([0-9a-f-]+)/status/?$ api/index.php?action=update-status&id=$1 [QSA,L,NC]
  RewriteRule ^api/pins/([0-9a-f-]+)/?$ api/index.php?action=get-pin&id=$1 [QSA,L,NC]
  RewriteRule ^api/pins/?$ api/index.php?action=list-pins [QSA,L,NC]
  RewriteRule ^api/messages/([0-9a-f-]+)/?$ api/index.php?action=delete-message&id=$1 [QSA,L,NC]
  RewriteRule ^api/admin/clear/?$ api/index.php?action=admin-clear [QSA,L,NC]
  RewriteRule ^api/health/?$ api/index.php?action=health [QSA,L,NC]
</IfModule>

<FilesMatch "(?i)^(?!index\.php$).+\.(?:php[0-9]*|phtml|phar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(?i)(^\.|\.(?:bak|old|orig|save|sql|sqlite3?|db|log|map|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
  Header always unset X-Powered-By
</IfModule>
